<% layout("./layouts/boilerplate.ejs")%>
<body>
    <div class="row my-2">
        <div class="col-8 offset-2 mt-4">
            <h1>Create a new Listing</h1>
            <form method="POST" action="/listings" novalidate class="needs-validation mt-3" enctype="multipart/form-data">
              <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input
                  name="listing[title]"
                  placeholder="Add a catchy Title"
                  type="text"
                  class="form-control"
                  required
                />
                <div class="valid-feedback">
                    Title looks good!
                </div>
                <div class="invalid-feedback">
                    Can't Skip the Title 
                </div>
              </div>
              
              <div class="mb-3">
                  <label for="description" class="form-label">Description</label>
                  <textarea
                  name="listing[description]"
                  class="form-control"
                  required
                  ></textarea>
                  <div class="valid-feedback">
                    Nice Work
                </div>
                <div class="invalid-feedback">
                    Can't skip the description
                    <br>
                    Tip : Use ChatGPT
                </div>
              </div>
              <div class="mb-3">
                  <label for="image" class="form-label">Upload Listing Images</label>
                  <input name="listing[image]" placeholder="Enter the image url" class="form-control" type="file"/>
              </div>
          
              <div class="row">
                <div class="col-md-4">
                    <label for="price" class="form-label">Price</label>
                    <input name="listing[price]" placeholder="Enter the Price" type="text" class="form-control"
                    required/>
                    <div class="invalid-feedback">
                        Enter a valid price 
                    </div>
                </div>
                  <div class="mb-3 col-md-8">
                    <label for="country" class="form-label">Country</label>
                    <input name="listing[country]" placeholder="Eg : India" class="form-control" required/>
                    <div class="invalid-feedback">
                        Country should not be empty
                    </div>
                </div>
              </div>

              <div class="row">
                  <div class="mb-3 col-md-12">
                      <label for="location" class="form-label">Location</label>
                      <input name="listing[location]" placeholder="Eg : Madurai,TamilNadu" class="form-control" 
                      required/>
                    <div class="invalid-feedback">
                        Location should not be empty
                    </div>
                  </div>
              </div>
          
              
              <button class="btn btn-dark add-btn mb-3">Add</button>
            </form>
        </div>
    </div>
</body>
