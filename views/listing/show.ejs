<% layout("./layouts/boilerplate.ejs")%>
<body>
  <div class="row mt-3 ">
        <div class="col-8 offset-3">
            <h1><%=listing.title%></h1>
        </div>
        <div class="listing-card card col-6 offset-3 mt-2">
            <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="<%=listing.image.filename%>" />
            <div class="card-body mb-3">
                    <div class="mb-2">
                        Owned by <i><%=listing.owner.username%></i>
                    </div>
                    <div class="mx-3 mb-2">
                        <b>
                            <%=listing.description%>
                        </b>
                    </div>
                    <div class="mb-2">
                        Price : &#8377;<b><%=listing.price.toLocaleString("en-In")%></b>
                    </div>
                    <div class="mb-2">
                        <%=listing.location%>,<%=listing.country%>
                    </div>
            </div>
            <%if(currUser && currUser._id.equals(listing.owner._id)){ %>
            <div class="btns">
                <a href="/listings/<%=listing._id%>/edit" class="col-1 btn btn-dark edit-btn"
                >Edit</a
                >
                <form method="POST" action="/listings/<%=listing.id%>?_method=DELETE">
                <button class="offset-2 btn btn-dark">Delete</button>
                </form>
            </div>
            <% } %>
            <% if(currUser){ %>
            <hr>
            <div>
                <h4>Add your review:</h4>
                <form class="needs-validation" action="/listings/<%=listing._id%>/review" method="post" novalidate class="needs-validation">
                <div class=" mt-3">
                    <label for="rating" class="form-label">Rating</label>
                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate"name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1"name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2"name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3"name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4"name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5"name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>
                    <div class="mb-3">
                        <label for="comment" class="form-label">Comments</label>
                        <br>
                        <textarea name="review[comment]" id="comment" rows="5" cols="50" class="form-control" required></textarea >
                        <div class="invalid-feedback">Comment can't be empty</div>
                    </div>
                    <button class="btn btn-dark">Submit</button>
                </form>
            </div>
            <% } %>
            <hr>
            <%if(listing.reviews.length > 0){%>
            <h4>All Reviews</h4>
            <div class="row mt-3">
                <%for(let rev of listing.reviews){%>
                    <div class="card ms-3 mb-3">
                        <div class="card-body mb-3 mt-2">
                            <p class="card-title">
                                <i>Author :</i><b><%= rev.author.username%></b> , <%=rev.createAt.toString().slice(4,7)%> <%=rev.createAt.toString().slice(11,15)%>
                            </p>
                            <p class="ms-4 card-text">
                                <p class="starability-result" data-rating="<%=rev.rating%>"></p> 
                                <%=rev.comment%>
                            </p>
                        </div>
                        <% if(currUser && rev.author.equals(currUser._id)){ %>
                        <form method="post" action="/listings/<%=listing._id%>/review/<%=rev._id%>?_method=DELETE">
                            <button class="btn btn-dark mb-3">Delete</button>
                        </form>
                        <% } %>
                    </div>
                <%}%>
            </div>
            <%}%>
        </div>
  </div>
</body>
