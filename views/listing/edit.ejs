<% layout("./layouts/boilerplate.ejs")%>
<body>
  <div class="row my-3">
    <div class="col-8 offset-2 mt-4">
      <h1>Edit Listing:</h1>
      <form method="POST" action="/listings/<%=listing._id%>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3 mt-3">
          <label for="title" class="form-label">Title</label>
          <input
            name="listing[title]"
            placeholder="Enter the Title"
            value="<%=listing.title%>"
            class="form-control"
            required
            />
            <div class="invalid-feedback">
              Can't Skip the Title 
          </div>
        </div>
        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea name="listing[description]" class="form-control" required>
<%=listing.description%></textarea
          >
          <div class="invalid-feedback">
            Can't skip the description
            <br>
            Tip : Use ChatGPT
        </div>
        </div>
        <div class="mb-3">
          <p>
            Original Listing Image
          </p>
          <img src="<%= orgImgUrl %>">
        </div>
        <div class="mb-3">
          <label for="image" class="form-label">Upload New Image</label>
          <input
            name="listing[image]"
            type="file"
            placeholder="Enter the image url"
            class="form-control"
          />
          <div class="invalid-feedback">
            Image can't be empty
          </div>
        </div>
        <div class="mb-3">
          <label for="price" class="form-label">Price</label>
          <input
            name="listing[price]"
            value="<%=listing.price%>"
            placeholder="Enter the Price"
            type="text"
            class="form-control"
            required
          />
          <div class="invalid-feedback">
            Enter a valid price 
        </div>
        </div>
        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="country" class="form-label">Country</label>
            <input
              name="listing[country]"
              placeholder="Eg : India"
              value="<%=listing.country%>"
              class="form-control"
              required
            />
            <div class="invalid-feedback">
              Country should not be empty
          </div>
          </div>
          <div class="mb-3 col-md-8">
            <label for="location" class="form-label">Location</label>
            <input
              name="listing[location]"
              placeholder="Eg : Madurai,TamilNadu"
              value="<%=listing.location%>"
              class="form-control"
              required
            />
            <div class="invalid-feedback">
              Location should not be empty
          </div>
          </div>
        </div>
        <button class="btn btn-dark edit-btn mb-3">Edit</button>
      </form>
    </div>
  </div>
</body>
